{%- endfor %}
    return _gws.call(
        __opts__,
        __pillar__,
        {{ service | tojson }},
        {{ m.resource_path_repr }},
        {{ m.method_name | tojson }},
        params=_params or None,
{%- if m.has_body %}
        body=body,
{%- endif %}
{%- if m.has_upload %}
        upload=upload,
{%- endif %}
    )
